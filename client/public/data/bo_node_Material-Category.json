{"termId": "122841924169", "name": "Material Category", "fqn": "Supply Chain.Material Category", "kind": "TERM", "status": "ACTIVE", "description": "A class of material the network moves. Sole-source risk is a property of a category, not of a plant, which is why it needs to be its own class. In the supply chain model: A Material Flow carries a Material Category (N:1). A Plant produces a Material Category (N:N). Source: Supply Chain Ontology app, SAP_SUPPLY_CHAIN.ONTOLOGY.", "synonyms": ["MaterialCategory"], "appClass": "MaterialCategory", "edges": [{"type": "CLASSIFIES", "label": null, "direction": "out", "node": "Material Flow"}, {"type": "CUSTOM", "label": "produces", "direction": "in", "node": "Plant"}], "representations": [{"object": "VW_ONT_MATERIALCATEGORY", "fqn": "SAP_SUPPLY_CHAIN.ONTOLOGY.VW_ONT_MATERIALCATEGORY", "objectType": "View", "role": "DESCRIBES", "validity": "VALID"}, {"object": "V_PRODUCES", "fqn": "SAP_SUPPLY_CHAIN.ONTOLOGY.V_PRODUCES", "objectType": "View", "role": "DESCRIBES", "validity": "VALID"}], "history": {"events": 6, "truncated": false, "last": 1794597366005, "changedBy": ["DFRERIKS"]}, "createdOn": 1794585661006, "lastModifiedOn": 1794585694246, "snowsightUrl": "https://app.snowflake.com/sfsenorthamerica/dfreriks_aws1_w2/#/data/business-ontology/domain/Supply%20Chain/entity/Material%20Category"}